(define (problem DLOG-1-2-2-197)
	(:domain driverlog)
	(:objects
	driver1 - driver
	truck1 - truck
	truck2 - truck
	package1 - obj
	package2 - obj
	s0 - location
	s1 - location
	s2 - location
	s3 - location
	s4 - location
	p0-4 - location
	p2-0 - location
	p2-4 - location
	p4-1 - location
	p1-0 - location
	p1-2 - location
	p3-1 - location
	)
	(:init
	(at driver1 s4)
	(at truck1 s4)
	(empty truck1)
	(= (load truck1) 0)
	(= (fuel-per-minute truck1) 10)
	(at truck2 s2)
	(empty truck2)
	(= (load truck2) 0)
	(= (fuel-per-minute truck2) 10)
	(at package1 s4)
	(at package2 s4)
	(path s0 p0-4)
	(path p0-4 s0)
	(path s4 p0-4)
	(path p0-4 s4)
	(= (time-to-walk s0 p0-4) 1)
	(= (time-to-walk p0-4 s0) 1)
	(= (time-to-walk s4 p0-4) 1)
	(= (time-to-walk p0-4 s4) 1)
	(path s2 p2-0)
	(path p2-0 s2)
	(path s0 p2-0)
	(path p2-0 s0)
	(= (time-to-walk s2 p2-0) 2)
	(= (time-to-walk p2-0 s2) 2)
	(= (time-to-walk s0 p2-0) 1)
	(= (time-to-walk p2-0 s0) 1)
	(path s2 p2-4)
	(path p2-4 s2)
	(path s4 p2-4)
	(path p2-4 s4)
	(= (time-to-walk s2 p2-4) 2)
	(= (time-to-walk p2-4 s2) 2)
	(= (time-to-walk s4 p2-4) 2)
	(= (time-to-walk p2-4 s4) 2)
	(path s4 p4-1)
	(path p4-1 s4)
	(path s1 p4-1)
	(path p4-1 s1)
	(= (time-to-walk s4 p4-1) 1)
	(= (time-to-walk p4-1 s4) 1)
	(= (time-to-walk s1 p4-1) 1)
	(= (time-to-walk p4-1 s1) 1)
	(path s1 p1-0)
	(path p1-0 s1)
	(path s0 p1-0)
	(path p1-0 s0)
	(= (time-to-walk s1 p1-0) 1)
	(= (time-to-walk p1-0 s1) 1)
	(= (time-to-walk s0 p1-0) 2)
	(= (time-to-walk p1-0 s0) 2)
	(path s1 p1-2)
	(path p1-2 s1)
	(path s2 p1-2)
	(path p1-2 s2)
	(= (time-to-walk s1 p1-2) 2)
	(= (time-to-walk p1-2 s1) 2)
	(= (time-to-walk s2 p1-2) 2)
	(= (time-to-walk p1-2 s2) 2)
	(path s3 p3-1)
	(path p3-1 s3)
	(path s1 p3-1)
	(path p3-1 s1)
	(= (time-to-walk s3 p3-1) 1)
	(= (time-to-walk p3-1 s3) 1)
	(= (time-to-walk s1 p3-1) 2)
	(= (time-to-walk p3-1 s1) 2)
	(link s2 s3)
	(link s3 s2)
	(= (time-to-drive s2 s3) 1)
	(= (time-to-drive s3 s2) 1)
	(link s2 s4)
	(link s4 s2)
	(= (time-to-drive s2 s4) 1)
	(= (time-to-drive s4 s2) 1)
	(link s0 s2)
	(link s2 s0)
	(= (time-to-drive s0 s2) 1)
	(= (time-to-drive s2 s0) 1)
	(link s4 s0)
	(link s0 s4)
	(= (time-to-drive s4 s0) 1)
	(= (time-to-drive s0 s4) 1)
	(link s4 s3)
	(link s3 s4)
	(= (time-to-drive s4 s3) 2)
	(= (time-to-drive s3 s4) 2)
	(link s3 s0)
	(link s0 s3)
	(= (time-to-drive s3 s0) 2)
	(= (time-to-drive s0 s3) 2)
	(link s1 s2)
	(link s2 s1)
	(= (time-to-drive s1 s2) 1)
	(= (time-to-drive s2 s1) 1)
	(link s1 s3)
	(link s3 s1)
	(= (time-to-drive s1 s3) 2)
	(= (time-to-drive s3 s1) 2)
	(= (fuel-used) 0)
)
	(:goal (and
	(at driver1 s4)
	(at truck1 s3)
	(at truck2 s0)
	(at package1 s4)
	(at package2 s4)
	))

(:metric minimize (+ (* 3 (total-time)) (* 3 (fuel-used))))

)
