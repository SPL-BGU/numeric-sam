	(at driver1 s0)
	(at driver2 s1)
	(at truck1 s2)
	(at truck2 s1)
	(at truck4 s2)
	(at truck5 s1)
	(at package1 s2)
	))

(:metric minimize (+ (* 4 (total-time)) (* 3 (fuel-used))))

)
