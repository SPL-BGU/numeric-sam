	(= (time-to-drive s1 s3) 18)
	(link s2 s0)
	(link s0 s2)
	(= (time-to-drive s2 s0) 27)
	(= (time-to-drive s0 s2) 27)
	(link s2 s1)
	(link s1 s2)
	(= (time-to-drive s2 s1) 30)
	(= (time-to-drive s1 s2) 30)
	(link s2 s3)
	(link s3 s2)
	(= (time-to-drive s2 s3) 38)
	(= (time-to-drive s3 s2) 38)
	(link s0 s1)
	(link s1 s0)
