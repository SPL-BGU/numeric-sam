(define (problem DLOG-1-3-1-153)
	(:domain driverlog)
	(:objects
	driver1 - driver
	truck1 - truck
	truck2 - truck
	truck3 - truck
	package1 - obj
	s0 - location
	s1 - location
	s2 - location
	s3 - location
	p3-0 - location
	p1-2 - location
	p1-3 - location
	)
	(:init
	(at driver1 s3)
	(at truck1 s1)
	(empty truck1)
	(= (load truck1) 0)
	(= (fuel-per-minute truck1) 10)
	(at truck2 s2)
	(empty truck2)
	(= (load truck2) 0)
	(= (fuel-per-minute truck2) 10)
	(at truck3 s2)
	(empty truck3)
	(= (load truck3) 0)
	(= (fuel-per-minute truck3) 10)
	(at package1 s2)
	(path s3 p3-0)
	(path p3-0 s3)
	(path s0 p3-0)
	(path p3-0 s0)
	(= (time-to-walk s3 p3-0) 5)
	(= (time-to-walk p3-0 s3) 5)
	(= (time-to-walk s0 p3-0) 38)
	(= (time-to-walk p3-0 s0) 38)
	(path s1 p1-2)
	(path p1-2 s1)
	(path s2 p1-2)
	(path p1-2 s2)
	(= (time-to-walk s1 p1-2) 55)
	(= (time-to-walk p1-2 s1) 55)
	(= (time-to-walk s2 p1-2) 73)
	(= (time-to-walk p1-2 s2) 73)
	(path s1 p1-3)
	(path p1-3 s1)
	(path s3 p1-3)
	(path p1-3 s3)
	(= (time-to-walk s1 p1-3) 38)
	(= (time-to-walk p1-3 s1) 38)
	(= (time-to-walk s3 p1-3) 77)
	(= (time-to-walk p1-3 s3) 77)
	(link s3 s0)
	(link s0 s3)
	(= (time-to-drive s3 s0) 23)
	(= (time-to-drive s0 s3) 23)
	(link s3 s1)
	(link s1 s3)
	(= (time-to-drive s3 s1) 31)
	(= (time-to-drive s1 s3) 31)
	(link s3 s2)
	(link s2 s3)
	(= (time-to-drive s3 s2) 11)
	(= (time-to-drive s2 s3) 11)
	(link s1 s0)
	(link s0 s1)
	(= (time-to-drive s1 s0) 45)
	(= (time-to-drive s0 s1) 45)
	(link s1 s2)
	(link s2 s1)
	(= (time-to-drive s1 s2) 49)
	(= (time-to-drive s2 s1) 49)
	(link s0 s2)
	(link s2 s0)
	(= (time-to-drive s0 s2) 23)
	(= (time-to-drive s2 s0) 23)
	(= (fuel-used) 0)
)
	(:goal (and
	(at driver1 s0)
	(at truck1 s0)
	(at truck2 s1)
	(at truck3 s0)
	(at package1 s3)
	))

(:metric minimize (+ (* 3 (total-time)) (* 3 (fuel-used))))

)
