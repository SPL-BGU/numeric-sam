(define (problem DLOG-4-2-2-157)
	(:domain driverlog)
	(:objects
	driver1 - driver
	driver2 - driver
	driver3 - driver
	driver4 - driver
	truck1 - truck
	truck2 - truck
	package1 - obj
	package2 - obj
	s0 - location
	s1 - location
	s2 - location
	s3 - location
	s4 - location
	p3-1 - location
	p3-4 - location
	p0-1 - location
	p2-1 - location
	p4-2 - location
	)
	(:init
	(at driver1 s3)
	(at driver2 s1)
	(at driver3 s0)
	(at driver4 s2)
	(at truck1 s1)
	(empty truck1)
	(= (load truck1) 0)
	(= (fuel-per-minute truck1) 10)
	(at truck2 s4)
	(empty truck2)
	(= (load truck2) 0)
	(= (fuel-per-minute truck2) 10)
	(at package1 s1)
	(at package2 s3)
	(path s3 p3-1)
	(path p3-1 s3)
	(path s1 p3-1)
	(path p3-1 s1)
	(= (time-to-walk s3 p3-1) 2)
	(= (time-to-walk p3-1 s3) 2)
	(= (time-to-walk s1 p3-1) 2)
	(= (time-to-walk p3-1 s1) 2)
	(path s3 p3-4)
	(path p3-4 s3)
	(path s4 p3-4)
	(path p3-4 s4)
	(= (time-to-walk s3 p3-4) 2)
	(= (time-to-walk p3-4 s3) 2)
	(= (time-to-walk s4 p3-4) 1)
	(= (time-to-walk p3-4 s4) 1)
	(path s0 p0-1)
	(path p0-1 s0)
	(path s1 p0-1)
	(path p0-1 s1)
	(= (time-to-walk s0 p0-1) 1)
	(= (time-to-walk p0-1 s0) 1)
	(= (time-to-walk s1 p0-1) 2)
	(= (time-to-walk p0-1 s1) 2)
	(path s2 p2-1)
	(path p2-1 s2)
	(path s1 p2-1)
	(path p2-1 s1)
	(= (time-to-walk s2 p2-1) 2)
	(= (time-to-walk p2-1 s2) 2)
	(= (time-to-walk s1 p2-1) 1)
	(= (time-to-walk p2-1 s1) 1)
	(path s4 p4-2)
	(path p4-2 s4)
	(path s2 p4-2)
	(path p4-2 s2)
	(= (time-to-walk s4 p4-2) 1)
	(= (time-to-walk p4-2 s4) 1)
	(= (time-to-walk s2 p4-2) 1)
	(= (time-to-walk p4-2 s2) 1)
	(link s1 s4)
	(link s4 s1)
	(= (time-to-drive s1 s4) 1)
	(= (time-to-drive s4 s1) 1)
	(link s0 s1)
	(link s1 s0)
	(= (time-to-drive s0 s1) 2)
	(= (time-to-drive s1 s0) 2)
	(link s0 s2)
	(link s2 s0)
	(= (time-to-drive s0 s2) 2)
	(= (time-to-drive s2 s0) 2)
	(link s0 s4)
	(link s4 s0)
	(= (time-to-drive s0 s4) 2)
	(= (time-to-drive s4 s0) 2)
	(link s3 s0)
	(link s0 s3)
	(= (time-to-drive s3 s0) 1)
	(= (time-to-drive s0 s3) 1)
	(link s3 s1)
	(link s1 s3)
	(= (time-to-drive s3 s1) 2)
	(= (time-to-drive s1 s3) 2)
	(link s3 s4)
	(link s4 s3)
	(= (time-to-drive s3 s4) 1)
	(= (time-to-drive s4 s3) 1)
	(= (fuel-used) 0)
)
	(:goal (and
	(at driver1 s1)
	(at driver2 s1)
	(at driver3 s1)
	(at driver4 s1)
	(at truck1 s0)
	(at truck2 s4)
	(at package1 s1)
	))

(:metric minimize (+ (* 3 (total-time)) (* 1 (fuel-used))))

)
